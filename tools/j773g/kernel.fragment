# SPDX-License-Identifier: MIT
# Kernel config fragment for J773g RAM-only bring-up, merged on top of the
# arm64 defconfig of the kernel base (GravityLinux gravity-m4 by default,
# legacy Asahi 77cb8f24c2 with BASE=asahi).
# Everything the boot ladder needs is built in: the busybox initramfs carries
# no modules. Mirrors upstream's night-3 kernel choices (16K pages, T8132
# stack =y, Rust/DRM_ASAHI/BTF off) plus the mini's tg3 Ethernet.

# Platform
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_APPLE_AIC=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_APPLE_PMGR_MISC=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_SART=y
CONFIG_APPLE_DART=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_I2C_APPLE=y
CONFIG_SPI_APPLE=y
CONFIG_APPLE_ADMAC=y

# Console on HDMI through simpledrm (iBoot framebuffer)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=n
CONFIG_LOGO=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM_ASAHI=n
CONFIG_RUST=n

# SMC (layer 1)
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_RTC_DRV_MACSMC=y

# Storage (layer 2)
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_VFAT_FS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# USB (layer 3)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=n
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_MULTIPLEXER=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_TYPEC_SN201202X=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_STORAGE=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# PCIe: Ethernet BCM57762 (tg3); Wi-Fi BCM4388 C2 (firmware only with
# WITH_FIRMWARE=1, from tools/j773g-wifi-fw.sh)
CONFIG_PCI=y
CONFIG_PCIE_APPLE=y
CONFIG_PCIEPORTBUS=y
CONFIG_TIGON3=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_PCIE=y
CONFIG_PHYLIB=y
CONFIG_BROADCOM_PHY=y

# Initramfs, debugging, size
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PANIC_TIMEOUT=-1
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_BTF=n
CONFIG_MODULES=y

# Native HDMI through DCP (only used by the g6-display rung and later)
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_APPLE=y
CONFIG_DRM_APPLE_AUDIO=n

# Persistent console in RAM (Gravity's ramoops reservation): after a hang or
# panic, a warm reboot into any rung shows the previous log in /sys/fs/pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Speaker safety: no J773g speaker profile has been reviewed yet. Keep every
# speaker-path driver out of the kernel (the ladder also disables the nodes).
CONFIG_SND_SOC_APPLE_T8132_SPEAKER=n
CONFIG_SND_SOC_TAS2764=n
CONFIG_SND_SOC_APPLE_MCA=n
