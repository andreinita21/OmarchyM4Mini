# SPDX-License-Identifier: MIT
# Arch Linux ARM build container for the J773g packages (packaging/j773g/*)
# and the Omarchy image (tools/j773g-image.sh). Built by tools/j773g-pkg.sh
# from the ArchLinuxARM-aarch64-latest.tar.gz rootfs it downloads into
# build/j773g/srcdest/. makepkg refuses root, so builds run as "builder".
FROM scratch
ADD ArchLinuxARM-aarch64-latest.tar.gz /

# pacman >= 7 sandboxes downloads with landlock/seccomp, which Docker's
# default seccomp profile does not allow.
RUN sed -i 's/^#*DisableSandbox.*/DisableSandbox/; /^\[options\]/a DisableSandbox' /etc/pacman.conf \
    && sed -i 's/^#\(ParallelDownloads\)/\1/' /etc/pacman.conf \
    && pacman-key --init && pacman-key --populate archlinuxarm \
    && pacman -Syu --noconfirm --needed \
         base-devel git sudo \
         bc cpio dtc kmod libelf pahole perl python rust-bindgen rustup tar xmlto xz \
         imagemagick \
         bison flex openssl swig python-setuptools uboot-tools \
         arch-install-scripts btrfs-progs dosfstools mtools \
    && pacman -Scc --noconfirm

RUN useradd -m builder && echo 'builder ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/builder \
    && install -d -o builder -g builder /work

# Rust: the kernel pins 1.93.1 (rust-toolchain.toml, as Omarchy's linux-aurora
# does); m1n1 needs the bare-metal softfloat target on the same toolchain.
USER builder
RUN rustup toolchain install 1.93.1 --profile minimal \
      --component rust-src --target aarch64-unknown-linux-gnu --target aarch64-unknown-none-softfloat \
    && rustup default 1.93.1
WORKDIR /work
