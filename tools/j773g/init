#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# J773g bring-up initramfs: print the rung verdict on the HDMI console
# (readable without a keyboard), then hand the console to a shell.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp
echo
echo "=== J773g initramfs: $(uname -r) ==="
cat /proc/cmdline
echo "=== probe results ==="
dmesg | grep -i -E 'macsmc|smc[-_]|rtkit|sart|nvme|dwc3|atcphy|sn201202|tps6598|typec|dart|apple-pcie|pcie-apple|tg3|brcmfmac|wlan|xhci|usb [0-9]|input:|simpledrm|fbcon|apple-drm|dcp|cpufreq|pstore|ramoops|error|fail|timed out|timeout' | grep -v -E 'SMC Calling|RPC:' | tail -40
mkdir -p /sys/fs/pstore
if mount -t pstore pstore /sys/fs/pstore 2>/dev/null && [ -n "$(ls /sys/fs/pstore)" ]; then
  echo "=== previous boot (pstore: $(ls /sys/fs/pstore | tr '\n' ' ')) ==="
  for f in /sys/fs/pstore/console-ramoops* /sys/fs/pstore/dmesg-ramoops*; do
    [ -f "$f" ] && { echo "--- $f"; tail -25 "$f"; }
  done
  echo "(full logs stay in /sys/fs/pstore until erased with rm)"
fi
echo "=== block devices ==="
cat /proc/partitions
echo "=== network ==="
ip -o link 2>/dev/null
echo "=== usb ==="
ls /sys/bus/usb/devices 2>/dev/null | tr '\n' ' '; echo
echo "=== done; shell on console (exit = panic = reboot) ==="
exec setsid cttyhack sh
