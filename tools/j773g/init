#!/bin/busybox sh
# SPDX-License-Identifier: MIT
# J773g bring-up initramfs: print the rung verdict on the HDMI console
# (readable without a keyboard), then hand the console to a shell.
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp
echo
echo "=== J773g initramfs: $(uname -r) ==="
cat /proc/cmdline
echo "=== probe results ==="
dmesg | grep -i -E 'macsmc|smc[-_]|rtkit|sart|nvme|dwc3|atcphy|sn201202|tps6598|typec|dart|apple-pcie|pcie-apple|tg3|brcmfmac|xhci|usb [0-9]|input:|simpledrm|fbcon|error|fail|timed out|timeout' | grep -v -E 'SMC Calling|RPC:' | tail -40
echo "=== block devices ==="
cat /proc/partitions
echo "=== network ==="
ip -o link 2>/dev/null
echo "=== usb ==="
ls /sys/bus/usb/devices 2>/dev/null | tr '\n' ' '; echo
echo "=== done; shell on console (exit = panic = reboot) ==="
exec setsid cttyhack sh
