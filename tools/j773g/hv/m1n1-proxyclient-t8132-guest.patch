--- a/proxyclient/m1n1/hv/sprr.py
+++ b/proxyclient/m1n1/hv/sprr.py
@@ -306,6 +306,18 @@ for src, dst in REMAP.items():
         _SYSREG[sysreg_encode(src, rd)] = _SYSREG.get(opcode, (opcode, 0))
 
 
+# M4 SPTM's guarded-level TLB maintenance: 0x00201401 (invalidate all) and
+# 0x002013xx (by address/ASID, Rt in bits 0-4). Under emulation SPTM runs at
+# EL1, so replace each with TLBI VMALLE1IS (over-invalidation is safe).
+TLBI_VMALLE1IS = 0xd508831f
+
+def patch_text_sptm_tlbi(data):
+    a = array.array("I", data)
+    for i, w in enumerate(a):
+        if w == 0x00201401 or w & 0xffffff00 == 0x00201300:
+            a[i] = TLBI_VMALLE1IS
+    return a.tobytes()
+
 def patch_text_sprr_emu(data):
     a = array.array("I", data)
 
