# J773g USB-C DisplayPort test kernel (RAM boots through the m1n1 proxy).
CONFIG_LOCALVERSION="-usbc"
CONFIG_RUST=n
CONFIG_PHY_APPLE_ATC=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_TYPEC_SN201202X=y
CONFIG_TYPEC_DP_ALTMODE=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_TIGON3=y
CONFIG_BROADCOM_PHY=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
# The USB-C controllers (tipd/sn201202x) wait for dwc3's role switch: build
# the USB host stack in, so the busybox initramfs needs no modules.
CONFIG_USB_GADGET=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_APPLE=y
