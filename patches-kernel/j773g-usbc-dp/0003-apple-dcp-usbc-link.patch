Subject: [PATCH 3/3] drm: apple: USB-C DP alt-mode link follows HPD, log DPTX PHY calls

A DCP whose DT has a DP PHY and apple,connector-type "DP" or "USB-C"
(dcp_is_typec_dp()) is a USB-C DP alt-mode output:

 - dcp_start() on 26.6 firmware no longer connects DPTX port 0 at startup
   for it (right for the always-wired HDMI converter, wrong for a USB-C
   port that may be empty); it logs that the link waits for HPD.
 - HPD from the Type-C controller (oob hotplug, patch 2) is recorded and
   applied by a work item: HPD high connects DPTX port 0 to the ATC PHY
   (apple,dptx-phy / apple,dptx-die), requests the display and raises HPD
   in DCP; HPD low, or a low pulse, releases it. The Type-C driver never
   blocks on DCP.
 - Every DPTX firmware callback on such ports is logged (name, sizes), plus
   the requested link rate, lane count, drive settings and what the ATC PHY
   reports from phy_validate().
 - New parameter appledrm.dptx_usbc_phy_dryrun (default on): PHY callbacks
   on USB-C ports are acknowledged without calling phy_configure() or
   phy_set_mode_ext(), because the T8132 ATC PHY has no DP lane programming
   yet. With it off, activate uses submode 0 (the ATC PHY rejects others).

HDMI (connector type "HDMI-A"), internal panels and DCPs without a PHY take
exactly the old paths; dptx_bypass_phy keeps its meaning for all ports.

---
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -331,6 +331,13 @@ static void apple_connector_oob_hotplug(struct drm_con
 {
 	struct apple_connector *apple_connector = to_apple_connector(connector);
 
+	/*
+	 * USB-C DP alt-mode outputs take HPD asynchronously; -ENODEV means
+	 * this is not one and the original path below applies.
+	 */
+	if (dcp_typec_hpd_oob(apple_connector->dcp, status) != -ENODEV)
+		return;
+
 	printk("#### oob_hotplug status:0x%x ####\n", (u32)status);
 
 	if (status == connector_status_connected)
--- a/drivers/gpu/drm/apple/dcp-internal.h
+++ b/drivers/gpu/drm/apple/dcp-internal.h
@@ -13,6 +13,9 @@
 #include <linux/platform_device.h>
 #include <linux/scatterlist.h>
 #include <linux/usb/typec_mux.h>
+#include <linux/workqueue.h>
+
+#include <drm/drm_mode.h>
 
 #include "dptxep.h"
 #include "iomfb.h"
@@ -302,8 +305,32 @@ struct apple_dcp {
 	u32 dptx_phy;
 	u32 dptx_die;
 	int hdmi_hpd_irq;
+
+	/*
+	 * USB-C DP alt-mode: HPD comes from the Type-C controller through
+	 * drm_connector_oob_hotplug_event() and is applied by typec_hpd_work.
+	 */
+	struct work_struct typec_hpd_work;
+	unsigned long typec_hpd_flags;
+	bool typec_link_up;
 };
 
+/* typec_hpd_flags bits */
+#define DCP_TYPEC_HPD_LEVEL	0	/* last HPD level from the Type-C controller */
+#define DCP_TYPEC_HPD_CYCLE	1	/* HPD went low since the worker last ran */
+
+/*
+ * A DP alt-mode output on a USB-C port: a DP PHY and connector type "DP" or
+ * "USB-C" in the device tree. Its link follows HPD from the Type-C
+ * controller. HDMI ("HDMI-A") and internal panels never match.
+ */
+static inline bool dcp_is_typec_dp(const struct apple_dcp *dcp)
+{
+	return dcp->phy &&
+	       (dcp->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+		dcp->connector_type == DRM_MODE_CONNECTOR_USB);
+}
+
 void dcp_drm_crtc_page_flip(struct apple_dcp *dcp, ktime_t now);
 
 int dcp_backlight_register(struct apple_dcp *dcp);
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -556,8 +556,13 @@ static int dcp_dptx_connect(struct apple_dcp *dcp, u32
 
 	usleep_range(5, 10);
 
-	if (dcp->connector_type == DRM_MODE_CONNECTOR_DisplayPort)
-		dptxport_set_hpd(dcp->dptxport[port].service, true);
+	if (dcp->connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+	    dcp_is_typec_dp(dcp)) {
+		ret = dptxport_set_hpd(dcp->dptxport[port].service, true);
+		if (dcp_is_typec_dp(dcp))
+			dev_info(dcp->dev, "USB-C DP: HPD high sent to DCP: %d\n",
+				 ret);
+	}
 
 	if (dcp->avep)
 		av_service_connect(dcp);
@@ -657,7 +662,88 @@ int dcp_dptx_release_oob(struct platform_device *pdev,
 
 	return dcp_dptx_disconnect(dcp, port);
 }
+
+/*
+ * USB-C DP alt-mode: apply the HPD level last reported by the Type-C
+ * controller. HPD high connects DPTX port 0 to the ATC PHY named by
+ * apple,dptx-phy / apple,dptx-die, requests the display and raises HPD
+ * in DCP; HPD low (or a low pulse since the last run) undoes it.
+ * Runs on a workqueue: connecting can wait up to DPTX_CONNECT_TIMEOUT for
+ * the firmware's link configuration and must not block the Type-C driver.
+ */
+static void dcp_typec_hpd_work(struct work_struct *work)
+{
+	struct apple_dcp *dcp = container_of(work, struct apple_dcp,
+					     typec_hpd_work);
+	bool cycle = test_and_clear_bit(DCP_TYPEC_HPD_CYCLE,
+					&dcp->typec_hpd_flags);
+	bool hpd = test_bit(DCP_TYPEC_HPD_LEVEL, &dcp->typec_hpd_flags);
+	int ret;
 
+	if (dcp->typec_link_up && (cycle || !hpd)) {
+		dev_info(dcp->dev, "USB-C DP: HPD %s, disconnecting DPTX port 0\n",
+			 hpd ? "pulsed low" : "low");
+		ret = dcp_dptx_disconnect_oob(to_platform_device(dcp->dev), 0);
+		dev_info(dcp->dev, "USB-C DP: DPTX port 0 disconnected: %d\n", ret);
+		dcp->typec_link_up = false;
+	}
+
+	if (!hpd || dcp->typec_link_up)
+		return;
+
+	if (dcp->crashed || !dcp->active) {
+		dev_warn(dcp->dev,
+			 "USB-C DP: HPD high but DCP is not running (crashed:%d active:%d)\n",
+			 dcp->crashed, dcp->active);
+		return;
+	}
+
+	dev_info(dcp->dev,
+		 "USB-C DP: HPD high, connecting DPTX port 0 to atc %u die %u\n",
+		 dcp->dptx_phy, dcp->dptx_die);
+	ret = dcp_dptx_connect(dcp, 0);
+	if (ret) {
+		dev_warn(dcp->dev, "USB-C DP: DPTX port 0 connect failed: %d\n",
+			 ret);
+		return;
+	}
+	dcp->typec_link_up = true;
+	dev_info(dcp->dev,
+		 "USB-C DP: DPTX port 0 connected (link rate 0x%x, %u lanes), waiting for DCP hotplug\n",
+		 dcp->dptxport[0].link_rate, dcp->dptxport[0].lane_count);
+}
+
+int dcp_typec_hpd_oob(struct platform_device *pdev,
+		      enum drm_connector_status status)
+{
+	struct apple_dcp *dcp = platform_get_drvdata(pdev);
+	bool old;
+
+	if (!dcp_is_typec_dp(dcp))
+		return -ENODEV;
+
+	switch (status) {
+	case connector_status_connected:
+		old = test_and_set_bit(DCP_TYPEC_HPD_LEVEL, &dcp->typec_hpd_flags);
+		break;
+	case connector_status_disconnected:
+		old = test_and_clear_bit(DCP_TYPEC_HPD_LEVEL, &dcp->typec_hpd_flags);
+		set_bit(DCP_TYPEC_HPD_CYCLE, &dcp->typec_hpd_flags);
+		break;
+	default:
+		dev_err(dcp->dev, "USB-C DP: unexpected oob hotplug status %d\n",
+			status);
+		return 0;
+	}
+
+	if (old != (status == connector_status_connected))
+		dev_info(dcp->dev, "USB-C DP: HPD %s from the Type-C controller\n",
+			 status == connector_status_connected ? "high" : "low");
+
+	queue_work(system_long_wq, &dcp->typec_hpd_work);
+	return 0;
+}
+
