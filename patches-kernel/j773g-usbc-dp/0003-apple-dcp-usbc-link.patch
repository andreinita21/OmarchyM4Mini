+		    dcp_is_typec_dp(dcp)) {
+			/* USB-C: the link follows HPD (dcp_typec_hpd_work) */
+			dev_info(dcp->dev,
+				 "USB-C DP: DPTX port 0 ready (atc %u die %u), link waits for HPD\n",
+				 dcp->dptx_phy, dcp->dptx_die);
+		} else if (v26_6 && !ret && dcp->dptxport[0].enabled) {
 			ret = dcp_dptx_connect(dcp, 0);
 			if (ret)
 				dev_warn(dcp->dev,
@@ -1799,6 +1891,8 @@ static void dcp_comp_unbind(struct device *dev, struct
 	if (dcp->hdmi_hpd_irq)
 		disable_irq(dcp->hdmi_hpd_irq);
 
+	cancel_work_sync(&dcp->typec_hpd_work);
+
 	if (dcp->dpdevep)
 		afk_cancel_commands(dcp->dpdevep);
 
@@ -1938,6 +2032,7 @@ static int dcp_platform_probe(struct platform_device *
 	dcp->hw = *(struct apple_dcp_hw_data *)of_device_get_match_data(dev);
 
 	platform_set_drvdata(pdev, dcp);
+	INIT_WORK(&dcp->typec_hpd_work, dcp_typec_hpd_work);
 
 	dcp->phy = devm_phy_optional_get(dev, "dp-phy");
 	if (IS_ERR(dcp->phy)) {
--- a/drivers/gpu/drm/apple/dcp.h
+++ b/drivers/gpu/drm/apple/dcp.h
@@ -62,6 +62,8 @@ int dcp_dptx_release_oob(struct platform_device *pdev,
 void dcp_av_disconnect_oob(struct platform_device *pdev);
 int dcp_dptx_set_hpd_oob(struct platform_device *pdev, u32 port, bool hpd);
 int dcp_dptx_release_oob(struct platform_device *pdev, u32 port);
+int dcp_typec_hpd_oob(struct platform_device *pdev,
+		      enum drm_connector_status status);
 
 int iomfb_start_rtkit(struct apple_dcp *dcp);
 void iomfb_shutdown(struct apple_dcp *dcp);
--- a/drivers/gpu/drm/apple/dptxep.c
+++ b/drivers/gpu/drm/apple/dptxep.c
@@ -22,6 +22,55 @@ MODULE_PARM_DESC(dptx_bypass_phy, "Acknowledge DPTX PH
 static bool dptx_bypass_phy;
 module_param_named(dptx_bypass_phy, dptx_bypass_phy, bool, 0644);
 MODULE_PARM_DESC(dptx_bypass_phy, "Acknowledge DPTX PHY callbacks without MMIO");
+
+/*
+ * USB-C DP alt-mode bring-up on T8132: the ATC PHY's DP lane programming and
+ * the display crossbar are not implemented yet, so by default the firmware's
+ * PHY requests on USB-C outputs are logged and acknowledged without touching
+ * the ATC PHY. Set to 0 to pass them through to phy-apple-atc.
+ */
+static bool dptx_usbc_phy_dryrun = true;
+module_param_named(dptx_usbc_phy_dryrun, dptx_usbc_phy_dryrun, bool, 0644);
+MODULE_PARM_DESC(dptx_usbc_phy_dryrun,
+		 "USB-C DP: log DPTX PHY callbacks without calling the ATC PHY (default: on)");
+
+/* May this port's PHY callbacks reach the PHY driver? */
+static bool dptx_phy_live(const struct apple_dcp *dcp)
+{
+	if (dptx_bypass_phy)
+		return false;
+	if (dcp_is_typec_dp(dcp) && dptx_usbc_phy_dryrun)
+		return false;
+	return true;
+}
+
