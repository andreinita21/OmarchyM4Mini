+/*
+ * J773g experiment: run the T8103-generation DisplayPort aux power-up and the
+ * lane-config tail on T8122/T8132 too (the same ATC block with moved lane
+ * mode/crossbar offsets). Off by default; nothing changes unless set.
+ */
+static bool t8122_dp_experimental;
+module_param(t8122_dp_experimental, bool, 0644);
+MODULE_PARM_DESC(t8122_dp_experimental, "Run the DP aux/lane sequence on T8122/T8132 (experimental)");
 
 #define AUSPLL_FSM_CTRL 0x1014
 
