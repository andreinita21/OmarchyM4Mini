+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8122 && !t8122_dp_experimental)
 		return;
+	if (atcphy->hw->gen == ATCPHY_GENERATION_T8122)
+		dev_info(atcphy->dev, "j773g-dp: lane tail, dp_lane %d/%d\n",
