From ddecfb8eb6ad9806bc12b82e79c17fac1b2cea58 Mon Sep 17 00:00:00 2001
From: Niklas Sheth <hi@niklassheth.com>
Date: Fri, 18 Sep 2026 20:09:06 -0400
Subject: [PATCH] apple: Allow enough DRAM banks for the M4 boot memory map

Record the 32-bank setting used by the working M4 EFI boot configuration in the board defconfig so clean builds use the same limit.

Assisted-By: OpenAI Codex (GPT-6 Astra)
Signed-off-by: Niklas Sheth <hi@niklassheth.com>
---
 configs/apple_m1_defconfig | 1 +
 1 file changed, 1 insertion(+)

diff --git a/configs/apple_m1_defconfig b/configs/apple_m1_defconfig
index 28b96aff..aca93fa1 100644
--- a/configs/apple_m1_defconfig
+++ b/configs/apple_m1_defconfig
@@ -1,6 +1,7 @@
 CONFIG_ARM=y
 CONFIG_MISC=y
 CONFIG_ARCH_APPLE=y
+CONFIG_NR_DRAM_BANKS=32
 CONFIG_DEFAULT_DEVICE_TREE="apple/t8103-j274"
 CONFIG_SYS_BOOTM_LEN=0x800000
 CONFIG_SYS_LOAD_ADDR=0x0
-- 
2.55.0

